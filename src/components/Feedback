import { useState } from "react";

function Feedback() {
  const [yes, setYes] = useState(0);
  const [no, setNo] = useState(0);

  return (
    <section className="px-20 py-6">
      <h3 className="text-2xl font-bold">Was this guide helpful?</h3>
      <div className="mt-3 flex items-center gap-4">
        <button className="cursor-pointer rounded-lg bg-[#5C766D] px-8 py-3 text-xl font-bold text-[#EDE9E6]" onClick={() => setYes(yes + 1)}>Yes</button>
        <button className="cursor-pointer rounded-lg bg-[#C9996B] px-8 py-3 text-xl font-bold text-[#5C4F4A]" onClick={() => setNo(no + 1)}>No</button>
        <button className="cursor-pointer rounded-lg border-2 border-[#5C4F4A] px-8 py-3 text-xl font-bold" onClick={() => { setYes(0); setNo(0); }}>Clear</button>
        <p className="text-xl">Yes: {yes} · No: {no}</p>
      </div>
    </section>
  );
}
export default Feedback;